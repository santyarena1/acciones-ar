# Copiá este archivo a .env.local para desarrollo. En Vercel, cargá las mismas variables en Settings > Environment Variables.
# NUNCA subas valores reales al repositorio.

# Base de datos (Neon). Vacío en desarrollo = usa PGlite local en web/.pglite
DATABASE_URL=

# Firma de la cookie de sesión (mínimo 32 caracteres al azar). Ej: openssl rand -base64 48
SESSION_SECRET=

# Código de un solo uso para crear la cuenta del dueño en /setup (mínimo 24 caracteres al azar: openssl rand -base64 32)
SETUP_TOKEN=

# Clave de cifrado de secretos: 32 bytes en base64 (la MISMA en Vercel y en GitHub Actions). Ej: openssl rand -base64 32
CLAVE_CIFRADO=

# Secreto que Telegram manda en cada mensaje al webhook (letras, números, _ y -; 16 a 256 caracteres)
TELEGRAM_WEBHOOK_SECRET=

# Opcional: para que "Revisar ahora" arranque el operador al instante (token fine-grained con Actions: write)
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=santyarena1/acciones-ar
# Rama donde vive .github/workflows/operador.yml (por defecto master)
GITHUB_REF_OPERADOR=master

# Opcional: URL pública de la app (si no, se toma del pedido). Ej: https://operador.vercel.app
APP_URL=
