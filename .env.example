# Credenciales de InvertirOnline (las mismas del login web). Nunca commitear .env
IOL_USERNAME=
IOL_PASSWORD=
# Poner en 1 SOLO cuando quieras habilitar envío real de órdenes (además hace falta --live y confirmar)
IOL_LIVE_TRADING=0
# Opcional (solo para probar contra la base de la nube desde la PC; en la nube van como secrets de GitHub):
# DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require
# CLAVE_CIFRADO=   (base64 de 32 bytes, la misma que usa la web)
# SALIDA_SILENCIOSA=1   (solo imprime líneas de estado genéricas)
